# --- Telegram user-client credentials (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Session file (no extension). Treat it like a password: it grants full access to your Telegram account.
TG_SESSION=data/monitor

# --- Web server ---
APP_HOST=127.0.0.1
APP_PORT=8000
# If set, every /api call must send header "X-API-Key: <value>" (the dashboard prompts for it).
APP_API_KEY=

# --- Storage / config ---
DB_PATH=data/messages.db
MEDIA_DIR=data/media
CONFIG_PATH=config.yaml

# true = generate fake bot messages instead of connecting to Telegram (UI testing)
DEMO_MODE=false
